---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import HarvestCalendar from '../components/HarvestCalendar.astro';
---

<Base
  title="Sourcing & Roasting"
  description="How Woodfox Coffee picks and roasts its coffee: the plant, the place it grows, and a light-to-medium roast."
>
  <PageIntro
    label="Sourcing & Roasting"
    title="What goes into <em>the bag.</em>"
    lede="Three things decide how a coffee tastes: the plant it came from, where it grew and how it was roasted. Here’s how we handle each one, without the jargon."
    image="hillside"
  />

  <!-- Pillar 1 -->
  <section class="section" aria-labelledby="p1-title">
    <div class="wrap grid-12 split">
      <div class="text">
        <p class="kicker label"><span class="num">01</span> The plant</p>
        <h2 class="h2" id="p1-title" data-reveal>Arabica gets the fame. Robusta deserves a second look.</h2>
        <div class="prose" data-reveal>
          <p>
            Almost all specialty coffee is Arabica, and for good reason: it’s sweet, bright and complex. Robusta has a
            bad reputation, mostly earned by the cheap stuff. Grown and processed with care, it brings body and depth
            that Arabica alone can’t.
          </p>
          <p>
            We use both, alone or together, depending on what tastes best. Either way, the bag will say exactly what’s
            in it.
          </p>
        </div>
      </div>
      <div class="pic" data-reveal>
        <Photo image="cherriesBranch" ratio="4 / 5" sizes="(min-width: 900px) 40vw, 100vw" caption="Coffee cherries ripening on the plant." />
      </div>
    </div>
  </section>

  <!-- Pillar 2 -->
  <section class="section surface-coffee on-dark" aria-labelledby="p2-title">
    <div class="wrap grid-12 split reverse">
      <div class="pic" data-reveal>
        <Photo image="valley" ratio="5 / 4" sizes="(min-width: 900px) 46vw, 100vw" />
      </div>
      <div class="text">
        <p class="kicker label"><span class="num">02</span> The place</p>
        <h2 class="h2" id="p2-title" data-reveal>Up high, near the equator.</h2>
        <div class="prose" data-reveal>
          <p>
            Coffee picks up a lot from where it grows: the altitude, the sun, the rain, the soil. We lean toward
            high-elevation farms close to the equator, in places like Ethiopia and Kenya. Cherries ripen slowly up
            there, and slow usually means more flavor.
          </p>
          <p>
            Every bag will name the country and region. If we know the farm, we’ll name that too.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seasonality -->
  <section class="section surface-light" aria-labelledby="season-title">
    <div class="wrap grid-12">
      <div class="season-text">
        <p class="kicker label"><span class="num">—</span> Seasonality</p>
        <h3 class="h2" id="season-title" data-reveal>Coffee is fruit. It has a season.</h3>
        <div class="prose" data-reveal>
          <p>
            Every growing region harvests at a different time of year, so what we roast will change with the calendar.
            That’s a feature, not a bug.
          </p>
        </div>
      </div>
      <div class="season-cal" data-reveal>
        <HarvestCalendar />
      </div>
    </div>
  </section>

  <!-- Pillar 3 -->
  <section class="section" aria-labelledby="p3-title">
    <div class="wrap grid-12 split">
      <div class="text">
        <p class="kicker label"><span class="num">03</span> The roast</p>
        <h2 class="h2" id="p3-title" data-reveal>Light to medium. Never burnt.</h2>
        <div class="prose" data-reveal>
          <p>
            Roast a coffee dark enough and everything tastes like, well, dark roast. We stop well before that, in the
            light-to-medium range, so you can taste where it came from.
          </p>
          <p>
            We roast in small batches and record every one with roast-profiling software. When something tastes great,
            we can do it again. When it doesn’t, we know why. And we taste every coffee before it ships.
          </p>
        </div>
      </div>
      <div class="pic" data-reveal>
        <Photo image="roasterCooling" ratio="4 / 5" sizes="(min-width: 900px) 40vw, 100vw" caption="Freshly roasted coffee in the cooling tray." />
      </div>
    </div>
  </section>

  <!-- Transparency -->
  <section class="section statement-sec" aria-labelledby="honest-title">
    <div class="wrap">
      <p class="kicker label"><span class="num">—</span> Transparency</p>
      <h2 class="statement" id="honest-title" data-reveal>
        If we know it, we’ll tell you. If we don’t, we won’t make it up.
      </h2>
      <div class="honest">
        <div data-reveal>
          <h3 class="h3">What we’ll tell you</h3>
          <p class="muted">
            What plant it came from, where it grew, how it was processed, how dark we roasted it and what it tastes
            like. Plus the farm or co-op, when we can confirm it.
          </p>
        </div>
        <div data-reveal>
          <h3 class="h3">What we won’t claim</h3>
          <p class="muted">
            No made-up farmer friendships, no certifications we don’t have, no vague “ethically sourced” stickers. If
            any of that becomes true, you’ll hear about it.
          </p>
        </div>
      </div>
      <div class="next">
        <a class="btn" href="/coffee/">See the coffee</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .split {
    row-gap: 3rem;
    align-items: center;
  }
  .split .text {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.5rem;
  }
  .split .text .kicker {
    margin-bottom: 0;
  }
  .split .pic {
    grid-column: 8 / span 5;
  }
  .split.reverse .pic {
    grid-column: 1 / span 6;
  }
  .split.reverse .text {
    grid-column: 8 / span 5;
  }
  .surface-coffee .pic :global(.frame) {
    background: var(--coffee-2);
  }
  .surface-coffee .kicker .num {
    color: var(--rust-light);
  }
  .season-text {
    grid-column: 1 / span 4;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .season-text .kicker {
    margin-bottom: 0;
  }
  .season-cal {
    grid-column: 6 / span 7;
  }
  .statement-sec {
    border-top: 1px solid var(--line);
  }
  .statement {
    font-family: var(--serif);
    font-weight: 360;
    font-size: var(--step-4);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 24ch;
    text-wrap: balance;
    margin-bottom: 3rem;
  }
  .honest {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem clamp(2rem, 5vw, 5rem);
  }
  .honest > div {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .next {
    margin-top: 3.5rem;
  }
  @media (max-width: 900px) {
    .split .text,
    .split .pic,
    .split.reverse .text,
    .split.reverse .pic,
    .season-text,
    .season-cal {
      grid-column: 1 / -1;
    }
    .split.reverse .pic {
      order: 2;
    }
    .split .pic {
      max-width: 560px;
    }
    .season-cal {
      margin-top: 2rem;
    }
    .honest {
      grid-template-columns: 1fr;
    }
  }
</style>
