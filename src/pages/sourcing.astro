---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import HarvestCalendar from '../components/HarvestCalendar.astro';
---

<Base
  title="Sourcing & Roasting"
  description="How Woodfox Coffee sources and roasts: careful species selection, high-elevation origins and precise light-to-medium roast profiles."
>
  <PageIntro
    label="Sourcing & Roasting"
    title="Three decisions. <em>One cup.</em>"
    lede="Every Woodfox coffee is shaped by three choices: which coffee species we use, where it’s grown, and how we roast it. Here’s how we approach each one."
    image="hillside"
  />

  <!-- Pillar 1 -->
  <section class="section" aria-labelledby="p1-title">
    <div class="wrap grid-12 split">
      <div class="text">
        <p class="kicker label"><span class="num">01</span> Species selection</p>
        <h2 class="h2" id="p1-title" data-reveal>Not all coffee comes from the same plant.</h2>
        <div class="prose" data-reveal>
          <p>
            Most specialty coffee is Arabica, prized for its sweetness, acidity and aromatic range. Robusta, a separate
            species, is often dismissed, but carefully grown, high-grade specialty Robusta can add body, depth and a
            richer texture.
          </p>
          <p>
            We don’t limit ourselves to one species. We choose and combine coffees for what they bring to the cup, and
            each bag will tell you exactly what’s inside.
          </p>
        </div>
      </div>
      <div class="pic" data-reveal>
        <Photo image="cherriesBranch" ratio="4 / 5" sizes="(min-width: 900px) 40vw, 100vw" caption="Coffee cherries ripening on the plant." />
      </div>
    </div>
  </section>

  <!-- Pillar 2 -->
  <section class="section surface-coffee on-dark" aria-labelledby="p2-title">
    <div class="wrap grid-12 split reverse">
      <div class="pic" data-reveal>
        <Photo image="valley" ratio="5 / 4" sizes="(min-width: 900px) 46vw, 100vw" />
      </div>
      <div class="text">
        <p class="kicker label"><span class="num">02</span> Geographic origin</p>
        <h2 class="h2" id="p2-title" data-reveal>Where it grows shapes how it tastes.</h2>
        <div class="prose" data-reveal>
          <p>
            Altitude, sunlight, rainfall and soil all leave their mark on a coffee. We favour high-elevation growing
            regions near the equator, such as Ethiopia and Kenya, where slow-ripening cherries tend to develop more
            complex, distinctive flavours.
          </p>
          <p>
            We’ll always tell you the country and region a coffee comes from, as specifically as we can.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seasonality -->
  <section class="section surface-light" aria-labelledby="season-title">
    <div class="wrap grid-12">
      <div class="season-text">
        <p class="kicker label"><span class="num">—</span> Seasonality</p>
        <h3 class="h2" id="season-title" data-reveal>Coffee is a crop, harvested in seasons.</h3>
        <div class="prose" data-reveal>
          <p>
            Each origin is harvested at a different time of year. Following the seasons helps us offer coffees while
            they’re fresh.
          </p>
        </div>
      </div>
      <div class="season-cal" data-reveal>
        <HarvestCalendar />
      </div>
    </div>
  </section>

  <!-- Pillar 3 -->
  <section class="section" aria-labelledby="p3-title">
    <div class="wrap grid-12 split">
      <div class="text">
        <p class="kicker label"><span class="num">03</span> Precision roasting</p>
        <h2 class="h2" id="p3-title" data-reveal>Light to medium, by design.</h2>
        <div class="prose" data-reveal>
          <p>
            We roast in small micro-batches and keep our profiles in the light-to-medium range. Roasting lighter lets
            a coffee’s origin, sweetness and acidity come through, rather than the flavour of the roast itself.
          </p>
          <p>
            Every roast is monitored and recorded with roast-profiling software, so we can repeat what works and refine
            what doesn’t. Each coffee is cupped for quality before it’s released.
          </p>
        </div>
      </div>
      <div class="pic" data-reveal>
        <Photo image="roasterCooling" ratio="4 / 5" sizes="(min-width: 900px) 40vw, 100vw" caption="Freshly roasted coffee in the cooling tray." />
      </div>
    </div>
  </section>

  <!-- Transparency -->
  <section class="section statement-sec" aria-labelledby="honest-title">
    <div class="wrap">
      <p class="kicker label"><span class="num">—</span> Transparency</p>
      <h2 class="statement" id="honest-title" data-reveal>
        Traceable where we can be. Honest where we can’t.
      </h2>
      <div class="honest">
        <div data-reveal>
          <h3 class="h3">What we’ll tell you</h3>
          <p class="muted">
            For every coffee: species, country and region, processing method, roast level and tasting notes, plus the
            producer or cooperative when that information is available and verified.
          </p>
        </div>
        <div data-reveal>
          <h3 class="h3">What we won’t claim</h3>
          <p class="muted">
            We won’t describe a relationship with a farm, a certification or a sourcing programme unless it’s true and
            we can stand behind it.
          </p>
        </div>
      </div>
      <div class="next">
        <a class="btn" href="/coffee/">Explore our coffee</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .split {
    row-gap: 3rem;
    align-items: center;
  }
  .split .text {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.5rem;
  }
  .split .text .kicker {
    margin-bottom: 0;
  }
  .split .pic {
    grid-column: 8 / span 5;
  }
  .split.reverse .pic {
    grid-column: 1 / span 6;
  }
  .split.reverse .text {
    grid-column: 8 / span 5;
  }
  .surface-coffee .pic :global(.frame) {
    background: var(--coffee-2);
  }
  .surface-coffee .kicker .num {
    color: var(--rust-light);
  }
  .season-text {
    grid-column: 1 / span 4;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .season-text .kicker {
    margin-bottom: 0;
  }
  .season-cal {
    grid-column: 6 / span 7;
  }
  .statement-sec {
    border-top: 1px solid var(--line);
  }
  .statement {
    font-family: var(--serif);
    font-weight: 360;
    font-size: var(--step-4);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 24ch;
    text-wrap: balance;
    margin-bottom: 3rem;
  }
  .honest {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem clamp(2rem, 5vw, 5rem);
  }
  .honest > div {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .next {
    margin-top: 3.5rem;
  }
  @media (max-width: 900px) {
    .split .text,
    .split .pic,
    .split.reverse .text,
    .split.reverse .pic,
    .season-text,
    .season-cal {
      grid-column: 1 / -1;
    }
    .split.reverse .pic {
      order: 2;
    }
    .split .pic {
      max-width: 560px;
    }
    .season-cal {
      margin-top: 2rem;
    }
    .honest {
      grid-template-columns: 1fr;
    }
  }
</style>
