---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
import { commerce } from '../../config/site';

const anyPlaceholder = products.some((p) => p.status === 'placeholder');

const details = [
  ['Where it grew', 'Country and region, and the farm or co-op when we can confirm it.'],
  ['Plant & process', 'Arabica, Robusta or both, and what happened to the cherries after they were picked.'],
  ['Roast', 'Light, light-medium or medium. We don’t do dark.'],
  ['Tasting notes', 'What we taste in the cup. “Cherry” means it tastes a bit like cherry, not that we added any.'],
  ['Sizes', '12 oz bags to start. Bigger 2 lb and 5 lb bags are planned for cafés and heavy drinkers.'],
];
---

<Base title="Our Coffee" description="The first Woodfox coffees: a Single Origin, a House Blend and an Espresso Blend, roasted light to medium in Houston. Coming soon.">
  <PageIntro
    label="Our Coffee"
    title="Three coffees, <em>almost ready.</em>"
    lede="A single origin for the curious, a house blend for every day, and an espresso blend for the machine on your counter. Here’s a first look."
  />

  <section class="section-sm collection" aria-labelledby="collection-title">
    <div class="wrap">
      <div class="toolbar">
        <h2 class="label" id="collection-title">The collection</h2>
        <p class="muted count">{products.length} coffee{products.length === 1 ? '' : 's'}</p>
      </div>

      {anyPlaceholder && (
        <p class="notice">
          <strong>In development</strong>
          <span>
            These are bag designs for our first three coffees. The coffees themselves are still being chosen and
            roasted, so anything printed on the bags (like tasting notes) is a placeholder, and nothing is for sale yet.
            We’ll post the real details as each one is ready.
          </span>
        </p>
      )}

      <div class="grid">
        {products.map((p) => <ProductCard product={p} />)}
      </div>

      {!commerce.enabled && (
        <div class="ordering">
          <h3 class="h3">Not for sale just yet.</h3>
          <p class="muted">
            Online ordering and subscriptions are on the way. Want to know the moment they’re live, or talk about
            coffee for your business? Get in touch.
          </p>
          <div class="ordering-actions">
            <a class="btn" href="/contact/">Contact us</a>
            <a class="link" href="/wholesale/">Wholesale <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section surface-deep" aria-labelledby="details-title">
    <div class="wrap grid-12">
      <div class="d-head">
        <p class="kicker label"><span class="num">—</span> On every bag</p>
        <h2 class="h2" id="details-title">What every bag will tell you.</h2>
        <p class="muted">And if we don’t know something, we’ll leave it off instead of guessing.</p>
      </div>
      <dl class="details">
        {details.map(([t, d]) => (
          <div>
            <dt class="h3">{t}</dt>
            <dd class="muted">{d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .count {
    font-size: var(--step--1);
  }
  .collection .notice {
    margin-bottom: 2.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3.5rem clamp(1rem, 2.5vw, 2rem);
  }
  .ordering {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--paper-light);
    border: 1px solid var(--line);
    max-width: 46rem;
  }
  .ordering-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }
  .d-head {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .d-head .kicker {
    margin-bottom: 0;
  }
  .details {
    grid-column: 7 / span 6;
  }
  .details div {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .details dt {
    font-size: var(--step-1);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .d-head,
    .details {
      grid-column: 1 / -1;
    }
    .details {
      margin-top: 2rem;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
