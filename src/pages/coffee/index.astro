---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import CoffeeCard from '../../components/CoffeeCard.astro';
import ListSection from '../../components/ListSection.astro';
import { getCoffees } from '../../data/coffees';

const coffees = await getCoffees();

const criteria = [
  {
    title: 'Quality',
    text: 'A coffee has to be clean, sweet and well balanced before we consider anything else. We taste every coffee before choosing it.',
  },
  {
    title: 'Character',
    text: 'We look for coffees that are distinct: a clear fruit, a particular sweetness, a texture you remember. Coffees that taste of where they’re from.',
  },
  {
    title: 'Seasonality',
    text: 'Harvests arrive at different times of year in different places. We follow them, so the list changes as the seasons do.',
  },
  {
    title: 'Availability',
    text: 'Good lots are finite. We choose from what is genuinely available to a roaster of our size, rather than promising a fixed lineup.',
  },
  {
    title: 'Freshness',
    text: 'Green coffee fades with time. We buy in quantities we can roast through while it still tastes vibrant.',
  },
  {
    title: 'Roasting fit',
    text: 'Every coffee needs to suit our approach: roasts developed individually, aiming for clarity and sweetness rather than heavy roast flavor.',
  },
];

const anatomy = [
  ['Country & region', 'Where the coffee was grown, as specifically as we can say.'],
  ['Producer', 'The farm, producer or cooperative, when that information is available and verified.'],
  ['Process', 'How the fruit was removed and the seed dried: washed, natural, honey and others. It shapes flavor as much as origin does.'],
  ['Variety', 'The plant cultivar, when known. Different varieties carry different potential in the cup.'],
  ['Tasting notes', 'What we taste when we cup it. A guide, not a promise of added flavors.'],
  ['Roast approach', 'A short note on how we roast that coffee and why.'],
];
---

<Base title="Coffee" description="How Woodfox Roasters selects coffee: by quality, character, season, availability and freshness.">
  <PageIntro
    label="Coffee"
    title="Chosen by <em>season,</em> not by habit."
    lede="We select each coffee for its quality and character, and offer it while it’s at its best. When it’s gone, something new takes its place."
    image="cherryPile"
  />

  <section class="section" aria-labelledby="criteria-title">
    <div class="wrap">
      <div class="head grid-12">
        <p class="kicker label"><span class="num">01</span> What we look for</p>
        <h2 class="h2" id="criteria-title">Six things every Woodfox coffee has to answer to.</h2>
      </div>
      <ol class="criteria" role="list">
        {criteria.map((c, i) => (
          <li data-reveal>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{c.title}</h3>
            <p class="muted">{c.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section surface-deep" id="coffees" aria-labelledby="coffees-title">
    <div class="wrap">
      <p class="kicker label"><span class="num">02</span> {coffees.length ? 'Current coffees' : 'Upcoming coffees'}</p>
      {coffees.length > 0 ? (
        <>
          <h2 class="h2 list-title" id="coffees-title">Current coffees</h2>
          <div class="grid">
            {coffees.map((c) => <CoffeeCard coffee={c} />)}
          </div>
        </>
      ) : (
        <>
          <h2 class="sr-only" id="coffees-title">Upcoming coffees</h2>
          <ComingSoon headingLevel="h3" />
        </>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="anatomy-title">
    <div class="wrap grid-12">
      <div class="anatomy-head">
        <p class="kicker label"><span class="num">03</span> On every coffee</p>
        <h2 class="h2" id="anatomy-title">What you’ll know about each coffee we offer.</h2>
        <p class="muted note">
          If we don’t know something, we’ll leave it out rather than guess.
        </p>
      </div>
      <dl class="anatomy">
        {anatomy.map(([term, desc]) => (
          <div class="a-row" data-reveal>
            <dt class="h3">{term}</dt>
            <dd class="muted">{desc}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <ListSection source="coffee" />
</Base>

<style>
  .head {
    row-gap: 0;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .head .kicker {
    grid-column: 1 / -1;
  }
  .head h2 {
    grid-column: 1 / span 8;
  }
  .criteria {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 clamp(1.5rem, 3vw, 3rem);
  }
  .criteria li {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding-block: 2rem 2.75rem;
    border-top: 1px solid var(--line);
  }
  .n {
    font-family: var(--serif);
    font-style: italic;
    color: var(--cherry);
  }
  .list-title {
    margin-bottom: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2rem;
  }
  .anatomy-head {
    grid-column: 1 / span 5;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 1.25rem;
  }
  .anatomy-head .kicker {
    margin-bottom: 0;
  }
  .note {
    max-width: 26rem;
  }
  .anatomy {
    grid-column: 7 / span 6;
  }
  .a-row {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .a-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .a-row dt {
    font-size: var(--step-1);
  }

  @media (max-width: 960px) {
    .criteria,
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 860px) {
    .head h2,
    .anatomy-head,
    .anatomy {
      grid-column: 1 / -1;
    }
    .anatomy-head {
      position: static;
      margin-bottom: 2rem;
    }
  }
  @media (max-width: 600px) {
    .criteria,
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
