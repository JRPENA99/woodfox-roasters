---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
import { commerce } from '../../config/site';

const anyPlaceholder = products.some((p) => p.status === 'placeholder');

const details = [
  ['Origin', 'The country and growing region, as specifically as we can say.'],
  ['Species & process', 'Arabica, specialty Robusta or a combination, and how the coffee was processed after harvest.'],
  ['Roast level', 'Light, light-medium or medium. We don’t roast dark.'],
  ['Tasting notes', 'What we taste when we cup it. A guide, not added flavouring.'],
  ['Sizes', '12 oz retail bags, with 2 lb and 5 lb bags planned for larger needs.'],
];
---

<Base title="Our Coffee" description="Woodfox Coffee's coffee collection: specialty coffees selected by species and origin and roasted light to medium in Houston, Texas.">
  <PageIntro
    label="Our Coffee"
    title="Selected with care. <em>Roasted with precision.</em>"
    lede="Each Woodfox coffee is chosen for its species and origin, then given a roast profile developed to bring out what makes it distinct."
  />

  <section class="section-sm collection" aria-labelledby="collection-title">
    <div class="wrap">
      <div class="toolbar">
        <h2 class="label" id="collection-title">The collection</h2>
        <p class="muted count">{products.length} coffee{products.length === 1 ? '' : 's'}</p>
      </div>

      {anyPlaceholder && (
        <p class="notice">
          <strong>In development</strong>
          <span>
            The collection is in development. These are packaging concepts for our first coffees, not finished
            products: text printed on the bags is illustrative, and none is available to buy yet. Origin, roast and
            tasting details will be published as each coffee is finalised.
          </span>
        </p>
      )}

      <div class="grid">
        {products.map((p) => <ProductCard product={p} />)}
      </div>

      {!commerce.enabled && (
        <div class="ordering">
          <h3 class="h3">Online ordering is coming soon.</h3>
          <p class="muted">
            We’re preparing secure online ordering and coffee subscriptions. Until then, reach out with any questions,
            or ask about wholesale for your business.
          </p>
          <div class="ordering-actions">
            <a class="btn" href="/contact/">Contact us</a>
            <a class="link" href="/wholesale/">Wholesale <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section surface-deep" aria-labelledby="details-title">
    <div class="wrap grid-12">
      <div class="d-head">
        <p class="kicker label"><span class="num">—</span> On every bag</p>
        <h2 class="h2" id="details-title">What you’ll know about each coffee.</h2>
        <p class="muted">If we don’t know something, we’ll leave it out rather than guess.</p>
      </div>
      <dl class="details">
        {details.map(([t, d]) => (
          <div>
            <dt class="h3">{t}</dt>
            <dd class="muted">{d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .count {
    font-size: var(--step--1);
  }
  .collection .notice {
    margin-bottom: 2.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3.5rem clamp(1rem, 2.5vw, 2rem);
  }
  .ordering {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--paper-light);
    border: 1px solid var(--line);
    max-width: 46rem;
  }
  .ordering-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }
  .d-head {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .d-head .kicker {
    margin-bottom: 0;
  }
  .details {
    grid-column: 7 / span 6;
  }
  .details div {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .details dt {
    font-size: var(--step-1);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .d-head,
    .details {
      grid-column: 1 / -1;
    }
    .details {
      margin-top: 2rem;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
