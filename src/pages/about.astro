---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';

const values = [
  {
    title: 'Quality',
    text: 'Every coffee is cupped and evaluated before it carries the Woodfox name.',
  },
  {
    title: 'Consistency',
    text: 'Roast profiles are developed carefully and recorded, so a coffee you love tastes the same next time.',
  },
  {
    title: 'Respect for the craft',
    text: 'From the farm to the roaster, coffee passes through many skilled hands. We aim to honour that work, not hide it.',
  },
  {
    title: 'Community',
    text: 'We’re a Houston company, and we want to meet the people who drink our coffee: at pop-ups, markets and cuppings.',
  },
];
---

<Base
  title="Our Story"
  description="Woodfox Coffee is a Houston-based specialty coffee company dedicated to thoughtful sourcing, precision roasting and exceptional coffee."
>
  <PageIntro
    label="Our Story"
    title="Rooted in Craft. <em>Driven by Purpose.</em>"
    lede="Woodfox Coffee is a Houston-based specialty coffee company dedicated to thoughtful sourcing, precision roasting and exceptional coffee."
    image="terraces"
  />

  <section class="section" aria-labelledby="story-title">
    <div class="wrap grid-12">
      <p class="kicker label k"><span class="num">01</span> What we believe</p>
      <h2 class="lede story-lede" id="story-title" data-reveal>
        We believe great coffee begins long before the first roast.
      </h2>
      <div class="prose story" data-reveal>
        <p>
          From the regions where our beans are grown to the careful development of each roast profile, every decision
          is guided by quality, consistency and respect for the craft.
        </p>
        <p>
          Our approach brings together distinctive coffee origins and carefully controlled roasting to highlight what
          makes each coffee unique.
        </p>
        <p>
          Whether you’re brewing at home, discovering us at a local event or partnering with us for your business, our
          mission is simple: to deliver coffee worth slowing down for.
        </p>
        <p class="sign">Woodfox Coffee — <em>Crafted with Intention.</em></p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Photo image="roasterCooling" ratio="21 / 9" sizes="(min-width: 1360px) 1360px, 100vw" class="wide" />
  </div>

  <section class="section" aria-labelledby="values-title">
    <div class="wrap">
      <p class="kicker label"><span class="num">02</span> What guides us</p>
      <h2 class="h2 values-title" id="values-title" data-reveal>The principles behind every bag.</h2>
      <ul class="values" role="list">
        {values.map((v, i) => (
          <li data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{v.title}</h3>
            <p class="muted">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-sm next" aria-label="Continue exploring">
    <div class="wrap next-grid">
      <a href="/coffee/" class="next-card">
        <span class="label muted">Our Coffee</span>
        <span class="h3">Explore the collection</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a href="/sourcing/" class="next-card">
        <span class="label muted">Sourcing &amp; Roasting</span>
        <span class="h3">How we choose and roast</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a href="/wholesale/" class="next-card">
        <span class="label muted">Wholesale</span>
        <span class="h3">Serve Woodfox coffee</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .k {
    grid-column: 1 / -1;
  }
  .story-lede {
    grid-column: 1 / span 6;
    font-size: var(--step-3);
    line-height: 1.15;
  }
  .story {
    grid-column: 8 / span 5;
    display: grid;
    gap: 1rem;
  }
  .sign {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--ink) !important;
  }
  .sign em {
    color: var(--cherry);
  }
  .wide :global(.frame) {
    min-height: 240px;
  }
  .values-title {
    max-width: 20ch;
    margin-bottom: 3rem;
  }
  .values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .values li {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ink);
  }
  .n {
    font-family: var(--serif);
    font-style: italic;
    color: var(--cherry);
  }
  .next {
    padding-top: 0;
  }
  .next-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .next-card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--paper);
    text-decoration: none;
    transition: background 0.3s var(--ease);
  }
  .next-card:hover {
    background: var(--paper-light);
  }
  .next-card .arrow {
    position: absolute;
    right: 1.5rem;
    top: 1.5rem;
    transition: transform 0.3s var(--ease);
  }
  .next-card:hover .arrow {
    transform: translateX(4px);
    color: var(--cherry);
  }
  @media (max-width: 960px) {
    .values {
      grid-template-columns: 1fr 1fr;
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 860px) {
    .story-lede,
    .story {
      grid-column: 1 / -1;
    }
    .story {
      margin-top: 2rem;
    }
    .next-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
