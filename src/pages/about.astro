---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';

const values = [
  {
    title: 'Taste it first',
    text: 'Nothing gets the Woodfox name until we’ve cupped it, argued about it and liked it.',
  },
  {
    title: 'Same bag, same coffee',
    text: 'Every roast is logged, so the coffee you liked last month tastes the same this month.',
  },
  {
    title: 'Credit the farm',
    text: 'A lot of skilled people touch a coffee before we do. A good roast shows off their work instead of covering it up.',
  },
  {
    title: 'Stay local',
    text: 'We want to meet the people drinking our coffee. Expect to find us at Houston markets, pop-ups and cuppings.',
  },
];
---

<Base
  title="Our Story"
  description="Woodfox Coffee is a small-batch specialty coffee roaster in Houston, Texas. Here’s who we are and what we care about."
>
  <PageIntro
    label="Our Story"
    title="A Houston roaster, <em>just getting started.</em>"
    lede="Woodfox is a small coffee company with a simple goal: roast coffee we’d be proud to hand to a friend, and do it right here in Houston."
    image="terraces"
  />

  <section class="section" aria-labelledby="story-title">
    <div class="wrap grid-12">
      <p class="kicker label k"><span class="num">01</span> Why we do this</p>
      <h2 class="lede story-lede" id="story-title" data-reveal>
        By the time coffee reaches a roaster, most of the hard work is already done. Our job is not to mess it up.
      </h2>
      <div class="prose story" data-reveal>
        <p>
          Somebody grew those beans, picked them by hand and dried them carefully. Then they crossed an ocean. The
          least we can do is roast them well.
        </p>
        <p>
          So we keep it simple. We look for coffees from places that grow great ones, roast them in small batches, keep
          notes on every roast, and taste the results before anything goes in a bag.
        </p>
        <p>
          We’re still early. The roaster is new, the first coffees are being chosen, and the bags you see on this site
          are designs, not finished products. If you want to follow along, or just talk coffee, we’d love to hear from
          you.
        </p>
        <p class="sign">— The Woodfox team, <em>Houston</em></p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Photo image="roasterCooling" ratio="21 / 9" sizes="(min-width: 1360px) 1360px, 100vw" class="wide" />
  </div>

  <section class="section" aria-labelledby="values-title">
    <div class="wrap">
      <p class="kicker label"><span class="num">02</span> House rules</p>
      <h2 class="h2 values-title" id="values-title" data-reveal>A few things we won’t budge on.</h2>
      <ul class="values" role="list">
        {values.map((v, i) => (
          <li data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{v.title}</h3>
            <p class="muted">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-sm next" aria-label="Continue exploring">
    <div class="wrap next-grid">
      <a href="/coffee/" class="next-card">
        <span class="label muted">Our Coffee</span>
        <span class="h3">See the coffee</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a href="/sourcing/" class="next-card">
        <span class="label muted">Sourcing &amp; Roasting</span>
        <span class="h3">How we pick and roast</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a href="/wholesale/" class="next-card">
        <span class="label muted">Wholesale</span>
        <span class="h3">Pour it at your place</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .k {
    grid-column: 1 / -1;
  }
  .story-lede {
    grid-column: 1 / span 6;
    font-size: var(--step-3);
    line-height: 1.15;
  }
  .story {
    grid-column: 8 / span 5;
    display: grid;
    gap: 1rem;
  }
  .sign {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--ink) !important;
  }
  .sign em {
    color: var(--cherry);
  }
  .wide :global(.frame) {
    min-height: 240px;
  }
  .values-title {
    max-width: 20ch;
    margin-bottom: 3rem;
  }
  .values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .values li {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ink);
  }
  .n {
    font-family: var(--serif);
    font-style: italic;
    color: var(--cherry);
  }
  .next {
    padding-top: 0;
  }
  .next-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .next-card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--paper);
    text-decoration: none;
    transition: background 0.3s var(--ease);
  }
  .next-card:hover {
    background: var(--paper-light);
  }
  .next-card .arrow {
    position: absolute;
    right: 1.5rem;
    top: 1.5rem;
    transition: transform 0.3s var(--ease);
  }
  .next-card:hover .arrow {
    transform: translateX(4px);
    color: var(--cherry);
  }
  @media (max-width: 960px) {
    .values {
      grid-template-columns: 1fr 1fr;
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 860px) {
    .story-lede,
    .story {
      grid-column: 1 / -1;
    }
    .story {
      margin-top: 2rem;
    }
    .next-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
