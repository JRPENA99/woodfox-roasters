---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../config/site';

const partners = [
  ['Independent coffee shops', 'Seasonal, carefully profiled coffees for espresso and filter.'],
  ['Restaurants', 'A coffee that holds its own at the end of a well-made meal.'],
  ['Specialty grocers', 'Locally roasted Houston coffee for your shelves.'],
  ['Offices', 'Better coffee for teams who notice the difference.'],
  ['Hospitality', 'Hotels, venues and guest experiences where details matter.'],
  ['Other partners', 'If coffee matters to what you do, we’d be glad to talk.'],
];

const benefits = [
  ['Roasted fresh in Houston', 'Micro-batch roasting close to you, so coffee arrives fresh rather than sitting in a warehouse.'],
  ['Consistent from bag to bag', 'Recorded roast profiles and cupping-based quality checks keep each coffee dependable.'],
  ['Formats that fit', 'Retail-ready 12 oz bags, with larger 2 lb and 5 lb bags planned for café and kitchen use.'],
  ['A direct relationship', 'You’ll work with the people who source and roast your coffee, not a call centre.'],
];
---

<Base
  title="Wholesale"
  description="Wholesale specialty coffee from Woodfox Coffee for Houston coffee shops, restaurants, specialty grocers, offices and hospitality businesses."
>
  <PageIntro
    label="Wholesale"
    title="Coffee for businesses that <em>care what they serve.</em>"
    lede="Woodfox Coffee partners with Houston businesses that want freshly roasted, carefully profiled specialty coffee. Tell us about your business and we’ll start the conversation."
    image="roaster"
  >
    <div class="intro-cta">
      <a class="btn" href="#inquiry">Start a wholesale inquiry</a>
    </div>
  </PageIntro>

  <section class="section" aria-labelledby="who-title">
    <div class="wrap">
      <p class="kicker label"><span class="num">01</span> Who we work with</p>
      <h2 class="h2 who-title" id="who-title" data-reveal>Partners who see coffee as part of what they offer.</h2>
      <ul class="partners" role="list">
        {partners.map(([t, d]) => (
          <li data-reveal>
            <h3 class="h3">{t}</h3>
            <p class="muted">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section surface-coffee on-dark" aria-labelledby="why-title">
    <div class="wrap grid-12">
      <div class="why-head">
        <p class="kicker label"><span class="num">02</span> Why Woodfox</p>
        <h2 class="h2" id="why-title" data-reveal>A roaster that’s close to home.</h2>
        <p class="body-lg" data-reveal>
          Pricing, quantities and delivery are tailored to each partner. Get in touch and we’ll walk you through the
          options.
        </p>
      </div>
      <ol class="benefits" role="list">
        {benefits.map(([t, d], i) => (
          <li data-reveal>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="h3">{t}</h3>
              <p class="muted">{d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="inquiry" aria-labelledby="inquiry-title">
    <div class="wrap grid-12">
      <div class="form-head">
        <p class="kicker label"><span class="num">03</span> Inquiry</p>
        <h2 class="h2" id="inquiry-title">Start the conversation.</h2>
        <p class="muted">
          Share a few details and we’ll follow up personally. Prefer email? Write to
          <a href={`mailto:${site.email}?subject=Wholesale%20inquiry`}>{site.email}</a>.
        </p>
      </div>
      <div class="form-col">
        <InquiryForm variant="wholesale" />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro-cta {
    grid-column: 6 / span 6;
  }
  .who-title {
    max-width: 22ch;
    margin-bottom: 3rem;
  }
  .partners {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 clamp(1.5rem, 3vw, 3rem);
  }
  .partners li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid var(--line);
  }
  .why-head {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .why-head .kicker {
    margin-bottom: 0;
  }
  .why-head .kicker .num,
  .n {
    color: var(--rust-light);
  }
  .benefits {
    grid-column: 7 / span 6;
    display: grid;
  }
  .benefits li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line-light);
  }
  .benefits li > div {
    display: grid;
    gap: 0.5rem;
  }
  .n {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-1);
  }
  .form-head {
    grid-column: 1 / span 4;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .form-head .kicker {
    margin-bottom: 0;
  }
  .form-head a {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .form-col {
    grid-column: 6 / span 7;
  }
  @media (max-width: 960px) {
    .partners {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 860px) {
    .intro-cta,
    .why-head,
    .benefits,
    .form-head,
    .form-col {
      grid-column: 1 / -1;
    }
    .benefits,
    .form-col {
      margin-top: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .partners {
      grid-template-columns: 1fr;
    }
  }
</style>
