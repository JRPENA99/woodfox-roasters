---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../config/site';

const partners = [
  ['Coffee shops', 'Espresso and filter coffees that change with the seasons, so your menu doesn’t go stale.'],
  ['Restaurants', 'The last thing your guests taste. It should be as good as everything before it.'],
  ['Grocers & shops', 'A Houston-roasted bag your regulars will come back for.'],
  ['Offices', 'Because the break room deserves better than a tin of pre-ground.'],
  ['Hotels & venues', 'For places where the little details are the whole point.'],
  ['Something else?', 'If coffee is part of what you do, we’re happy to talk.'],
];

const benefits = [
  ['Roasted down the road', 'We roast in small batches right here in Houston, so your coffee shows up fresh instead of sitting in a warehouse.'],
  ['No surprises', 'Every roast is logged and tasted, so the coffee your customers liked last week tastes the same this week.'],
  ['Sizes that make sense', '12 oz bags for the shelf, with bigger 2 lb and 5 lb bags planned for hoppers and kitchens.'],
  ['Real people', 'Call or email and you’ll get the person who roasted your coffee, not a call center.'],
];
---

<Base
  title="Wholesale"
  description="Wholesale coffee from Woodfox, a small-batch roaster in Houston, for coffee shops, restaurants, grocers, offices and hotels."
>
  <PageIntro
    label="Wholesale"
    title="Good coffee for <em>your business.</em>"
    lede="If you serve coffee in Houston and you care how it tastes, we should talk. Tell us a little about your place and we’ll take it from there."
    image="roaster"
  >
    <div class="intro-cta">
      <a class="btn" href="#inquiry">Let’s talk</a>
    </div>
  </PageIntro>

  <section class="section" aria-labelledby="who-title">
    <div class="wrap">
      <p class="kicker label"><span class="num">01</span> Who it’s for</p>
      <h2 class="h2 who-title" id="who-title" data-reveal>Anyone who pours coffee and wants it to be good.</h2>
      <ul class="partners" role="list">
        {partners.map(([t, d]) => (
          <li data-reveal>
            <h3 class="h3">{t}</h3>
            <p class="muted">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section surface-coffee on-dark" aria-labelledby="why-title">
    <div class="wrap grid-12">
      <div class="why-head">
        <p class="kicker label"><span class="num">02</span> Why Woodfox</p>
        <h2 class="h2" id="why-title" data-reveal>Your roaster, a short drive away.</h2>
        <p class="body-lg" data-reveal>
          Every business is different, so pricing, amounts and delivery get worked out together. Reach out and we’ll walk you through the
          options.
        </p>
      </div>
      <ol class="benefits" role="list">
        {benefits.map(([t, d], i) => (
          <li data-reveal>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="h3">{t}</h3>
              <p class="muted">{d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="inquiry" aria-labelledby="inquiry-title">
    <div class="wrap grid-12">
      <div class="form-head">
        <p class="kicker label"><span class="num">03</span> Inquiry</p>
        <h2 class="h2" id="inquiry-title">Tell us about your place.</h2>
        <p class="muted">
          A few details is all we need. We’ll get back to you ourselves. Rather just email? Write to
          <a href={site.ordersHref + "?subject=Wholesale%20inquiry"}>{site.ordersEmail}</a>.
        </p>
      </div>
      <div class="form-col">
        <InquiryForm variant="wholesale" />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro-cta {
    grid-column: 6 / span 6;
  }
  .who-title {
    max-width: 22ch;
    margin-bottom: 3rem;
  }
  .partners {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 clamp(1.5rem, 3vw, 3rem);
  }
  .partners li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid var(--line);
  }
  .why-head {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .why-head .kicker {
    margin-bottom: 0;
  }
  .why-head .kicker .num,
  .n {
    color: var(--rust-light);
  }
  .benefits {
    grid-column: 7 / span 6;
    display: grid;
  }
  .benefits li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line-light);
  }
  .benefits li > div {
    display: grid;
    gap: 0.5rem;
  }
  .n {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-1);
  }
  .form-head {
    grid-column: 1 / span 4;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .form-head .kicker {
    margin-bottom: 0;
  }
  .form-head a {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .form-col {
    grid-column: 6 / span 7;
  }
  @media (max-width: 960px) {
    .partners {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 860px) {
    .intro-cta,
    .why-head,
    .benefits,
    .form-head,
    .form-col {
      grid-column: 1 / -1;
    }
    .benefits,
    .form-col {
      margin-top: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .partners {
      grid-template-columns: 1fr;
    }
  }
</style>
