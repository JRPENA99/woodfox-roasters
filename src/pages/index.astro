---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import Photo from '../components/Photo.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { commerce } from '../config/site';

const featured = products.slice(0, 3);
const anyPlaceholder = featured.some((p) => p.status === 'placeholder');

const pillars = [
  {
    n: '01',
    title: 'Species selection',
    text: 'We look beyond a single species, choosing high-grade Arabica and specialty Robusta for what each brings to the cup.',
    image: 'cherriesRipe',
  },
  {
    n: '02',
    title: 'Geographic origin',
    text: 'We favour high-elevation, equatorial growing regions, such as Ethiopia and Kenya, where altitude and climate shape distinctive coffees.',
    image: 'valley',
  },
  {
    n: '03',
    title: 'Precision roasting',
    text: 'Light-to-medium roasts, developed in micro-batches and tracked curve by curve, so every bag tastes the way we intended.',
    image: 'roasterCooling',
  },
] as const;
---

<Base overlayHeader>
  <HomeHero />

  <!-- Introduction -->
  <section class="section intro" id="intro" aria-labelledby="intro-title">
    <div class="wrap grid-12">
      <p class="kicker label intro-kicker"><span class="num">01</span> Woodfox Coffee</p>
      <h2 class="intro-statement" id="intro-title" data-reveal>
        A Houston-based specialty coffee company dedicated to <em>thoughtful sourcing</em> and precision roasting.
      </h2>
      <div class="intro-aside prose" data-reveal>
        <p>
          Great coffee begins long before the first roast. From the regions where our beans are grown to the
          development of each roast profile, every decision is guided by quality, consistency and respect for the
          craft.
        </p>
        <a class="link" href="/about/">Discover our story <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Featured coffee -->
  <section class="section-sm surface-deep featured" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="kicker label"><span class="num">02</span> Our Coffee</p>
          <h2 class="h2" id="featured-title">Featured coffee</h2>
        </div>
        <a class="link" href="/coffee/">View all coffee <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      {anyPlaceholder && (
        <p class="notice">
          <strong>In development</strong>
          <span>Our first coffees are still being roasted and profiled. The cards below are layout placeholders, not products for sale.</span>
        </p>
      )}
      <div class="grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      {!commerce.enabled && (
        <p class="muted soon">Online ordering is coming soon. In the meantime, <a href="/contact/">get in touch</a> with any questions.</p>
      )}
    </div>
  </section>

  <!-- Sourcing & roasting pillars -->
  <section class="section pillars" aria-labelledby="pillars-title">
    <div class="wrap">
      <div class="pillars-head grid-12">
        <p class="kicker label"><span class="num">03</span> Sourcing &amp; Roasting</p>
        <h2 class="h2" id="pillars-title" data-reveal>Three decisions shape every coffee we roast.</h2>
      </div>
      <ol class="cols" role="list">
        {pillars.map((p, i) => (
          <li data-reveal style={`transition-delay:${i * 110}ms`}>
            <Photo image={p.image} ratio="4 / 5" sizes="(min-width: 900px) 30vw, 100vw" />
            <div class="pmeta">
              <p class="label muted"><span class="pn">{p.n}</span></p>
              <h3 class="h3">{p.title}</h3>
              <p class="muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="link more" href="/sourcing/">How we source and roast <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- Story preview -->
  <section class="story" aria-labelledby="story-title">
    <div class="story-media on-dark">
      <Photo image="hillside" sizes="100vw" />
      <div class="story-shade" aria-hidden="true"></div>
      <div class="wrap story-head">
        <p class="kicker label"><span class="num">04</span> Our Story</p>
        <h2 class="h1" id="story-title" data-reveal>Rooted in Craft. Driven by Purpose.</h2>
        <p class="body-lg" data-reveal>
          Whether you’re brewing at home, finding us at a local event or partnering with us for your business, our
          mission is simple: coffee worth slowing down for.
        </p>
        <a class="btn btn-light" href="/about/">Read our story</a>
      </div>
    </div>
  </section>

  <!-- Wholesale -->
  <section class="section wholesale" aria-labelledby="wholesale-title">
    <div class="wrap grid-12">
      <div class="ws-text" data-reveal>
        <p class="kicker label"><span class="num">05</span> Wholesale</p>
        <h2 class="h1" id="wholesale-title">Partner with Woodfox.</h2>
        <p class="body-lg">
          Freshly roasted, carefully profiled coffee for independent cafés, restaurants, specialty grocers, offices and
          hospitality across Houston.
        </p>
        <div class="ws-actions">
          <a class="btn" href="/wholesale/">Wholesale inquiries</a>
          <a class="link" href="/contact/">Ask a question <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="ws-photos">
        <Photo image="dryingBeds" ratio="1 / 1" sizes="(min-width: 900px) 24vw, 50vw" class="ws-a" />
        <Photo image="roaster" ratio="3 / 4" sizes="(min-width: 900px) 24vw, 50vw" class="ws-b" />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: calc(var(--section) * 0.7);
  }
  .intro-kicker {
    grid-column: 1 / -1;
  }
  .intro-statement {
    grid-column: 1 / span 10;
    font-family: var(--serif);
    font-weight: 360;
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .intro-statement em {
    color: var(--rust);
  }
  .intro-aside {
    grid-column: 7 / span 5;
    margin-top: clamp(2rem, 1rem + 3vw, 4rem);
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .featured .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .featured .head .kicker {
    margin-bottom: 1rem;
  }
  .featured .notice {
    margin-bottom: 2.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem clamp(1rem, 2.5vw, 2rem);
  }
  .soon {
    margin-top: 2.5rem;
  }
  .soon a {
    color: var(--ink);
  }

  .pillars-head {
    row-gap: 0;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .pillars-head .kicker {
    grid-column: 1 / -1;
  }
  .pillars-head h2 {
    grid-column: 1 / span 8;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }
  .cols li:nth-child(2) {
    margin-top: clamp(0rem, 5vw, 5rem);
  }
  .pmeta {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
    max-width: 24rem;
  }
  .pn {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--cherry);
    letter-spacing: 0;
  }
  .more {
    margin-top: 3rem;
  }

  .story-media {
    position: relative;
    min-height: min(88vh, 820px);
    color: var(--paper);
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }
  .story-media > :global(.photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .story-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(12 18 11 / 0.72) 0%, rgb(12 18 11 / 0.15) 60%);
  }
  .story-head {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: 6rem clamp(3rem, 2rem + 3vw, 5rem);
  }
  .story-head .kicker {
    margin-bottom: 0;
  }
  .story-head .kicker .num {
    color: var(--rust-light);
  }
  .story-head h2 {
    max-width: 14ch;
  }
  .story-head p {
    max-width: 36rem;
    color: rgb(245 244 239 / 0.88);
  }

  .wholesale .grid-12 {
    align-items: center;
    row-gap: 3rem;
  }
  .ws-text {
    grid-column: 1 / span 6;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .ws-text .kicker {
    margin-bottom: 0;
  }
  .ws-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .ws-photos {
    grid-column: 8 / span 5;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: end;
  }
  .ws-photos :global(.ws-a) {
    margin-bottom: 3rem;
  }

  @media (max-width: 900px) {
    .intro-statement,
    .intro-aside,
    .pillars-head h2,
    .ws-text,
    .ws-photos {
      grid-column: 1 / -1;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cols {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .cols li:nth-child(2) {
      margin-top: 0;
    }
    .cols li {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: 1.25rem;
      align-items: end;
    }
    .pmeta {
      margin-top: 0;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .cols li {
      grid-template-columns: 1fr;
    }
    .cols li :global(.frame) {
      aspect-ratio: 4 / 3 !important;
    }
  }
</style>
