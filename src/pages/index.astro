---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import Photo from '../components/Photo.astro';
import ProductImage from '../components/ProductImage.astro';
import { products, statusLabel } from '../data/products';
import { commerce } from '../config/site';

// The first product (Single Origin) leads; the rest are listed beside it.
const [lead, ...rest] = products;

const pillars = [
  {
    n: '01',
    title: 'Species selection',
    text: 'We look beyond a single species, choosing high-grade Arabica and specialty Robusta for what each brings to the cup.',
    image: 'cherriesRipe',
  },
  {
    n: '02',
    title: 'Geographic origin',
    text: 'We favour high-elevation, equatorial growing regions, such as Ethiopia and Kenya, where altitude and climate shape distinctive coffees.',
    image: 'valley',
  },
  {
    n: '03',
    title: 'Precision roasting',
    text: 'Light-to-medium roasts, developed in micro-batches and tracked curve by curve, so every bag tastes the way we intended.',
    image: 'roasterCooling',
  },
] as const;
---

<Base overlayHeader>
  <HomeHero />

  <!-- Introduction -->
  <section class="section intro" id="intro" aria-labelledby="intro-title">
    <div class="wrap grid-12">
      <p class="kicker label intro-kicker"><span class="num">01</span> Woodfox Coffee</p>
      <h2 class="intro-statement" id="intro-title" data-reveal>
        A Houston-based specialty coffee company dedicated to <em>thoughtful sourcing</em> and precision roasting.
      </h2>
      <div class="intro-aside prose" data-reveal>
        <p>
          Great coffee begins long before the first roast. From the regions where our beans are grown to the
          development of each roast profile, every decision is guided by quality, consistency and respect for the
          craft.
        </p>
        <a class="link" href="/about/">Discover our story <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Featured coffee -->
  <section class="section featured" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="feature grid-12">
        <a class="feature-media" href={`/coffee/${lead.id}/`} tabindex="-1" aria-hidden="true">
          <ProductImage product={lead} variant="hero" sizes="(min-width: 900px) 48vw, 92vw" />
        </a>
        <div class="feature-text">
          <p class="kicker label"><span class="num">02</span> Our Coffee</p>
          <p class="label status">{statusLabel[lead.status]}</p>
          <h2 class="display" id="featured-title"><a href={`/coffee/${lead.id}/`}>{lead.name}</a></h2>
          <p class="body-lg">
            The first Woodfox coffees are being selected and profiled now. These packaging concepts show where the
            collection is heading; each coffee’s origin, roast and tasting notes will be published once they’re final.
          </p>
          <div class="feature-actions">
            <a class="btn" href="/coffee/">Explore our coffee</a>
            {!commerce.enabled && <span class="muted soon">Online ordering coming soon</span>}
          </div>

          <ul class="also" role="list" aria-label="Also in development">
            {rest.map((p) => (
              <li>
                <a href={`/coffee/${p.id}/`}>
                  <span class="thumb" style={`--backdrop:${p.backdrop}`}>
                    {p.image && (
                      <picture>
                        <source type="image/webp" srcset={`${p.image.base}-560.webp`} />
                        <img src={`${p.image.base}.png`} alt="" width={p.image.width} height={p.image.height} loading="lazy" decoding="async" />
                      </picture>
                    )}
                  </span>
                  <span class="also-text">
                    <span class="also-name">{p.name}</span>
                    <span class="label muted">{statusLabel[p.status]}</span>
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Sourcing & roasting pillars -->
  <section class="section pillars" aria-labelledby="pillars-title">
    <div class="wrap">
      <div class="pillars-head grid-12">
        <p class="kicker label"><span class="num">03</span> Sourcing &amp; Roasting</p>
        <h2 class="h2" id="pillars-title" data-reveal>Three decisions shape every coffee we roast.</h2>
      </div>
      <ol class="cols" role="list">
        {pillars.map((p, i) => (
          <li data-reveal style={`transition-delay:${i * 110}ms`}>
            <Photo image={p.image} ratio="4 / 5" sizes="(min-width: 900px) 30vw, 100vw" />
            <div class="pmeta">
              <p class="label muted"><span class="pn">{p.n}</span></p>
              <h3 class="h3">{p.title}</h3>
              <p class="muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="link more" href="/sourcing/">How we source and roast <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- Story preview -->
  <section class="story" aria-labelledby="story-title">
    <div class="story-media on-dark">
      <Photo image="hillside" sizes="100vw" />
      <div class="story-shade" aria-hidden="true"></div>
      <div class="wrap story-head">
        <p class="kicker label"><span class="num">04</span> Our Story</p>
        <h2 class="h1" id="story-title" data-reveal>Rooted in Craft. Driven by Purpose.</h2>
        <p class="body-lg" data-reveal>
          Whether you’re brewing at home, finding us at a local event or partnering with us for your business, our
          mission is simple: coffee worth slowing down for.
        </p>
        <a class="btn btn-light" href="/about/">Read our story</a>
      </div>
    </div>
  </section>

  <!-- Wholesale -->
  <section class="section wholesale" aria-labelledby="wholesale-title">
    <div class="wrap grid-12">
      <div class="ws-text" data-reveal>
        <p class="kicker label"><span class="num">05</span> Wholesale</p>
        <h2 class="h1" id="wholesale-title">Partner with Woodfox.</h2>
        <p class="body-lg">
          Freshly roasted, carefully profiled coffee for independent cafés, restaurants, specialty grocers, offices and
          hospitality across Houston.
        </p>
        <div class="ws-actions">
          <a class="btn" href="/wholesale/">Wholesale inquiries</a>
          <a class="link" href="/contact/">Ask a question <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="ws-photos">
        {rest.slice(0, 2).map((p, i) => <ProductImage product={p} sizes="(min-width: 900px) 22vw, 45vw" class={i === 0 ? 'ws-a' : 'ws-b'} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: calc(var(--section) * 0.7);
  }
  .intro-kicker {
    grid-column: 1 / -1;
  }
  .intro-statement {
    grid-column: 1 / span 10;
    font-family: var(--serif);
    font-weight: 360;
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .intro-statement em {
    color: var(--rust);
  }
  .intro-aside {
    grid-column: 7 / span 5;
    margin-top: clamp(2rem, 1rem + 3vw, 4rem);
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .feature {
    align-items: center;
    row-gap: 3rem;
  }
  .feature-media {
    grid-column: 1 / span 6;
    display: block;
  }
  .feature-media :global(img) {
    transition: transform 0.9s var(--ease);
  }
  .feature-media:hover :global(img) {
    transform: translateY(-8px);
  }
  .feature-text {
    grid-column: 8 / span 5;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .feature-text .kicker {
    margin-bottom: 0.5rem;
  }
  .feature-text .status {
    color: var(--cherry);
  }
  .feature-text h2 a {
    text-decoration: none;
  }
  .feature-text h2 a:hover {
    color: var(--rust);
  }
  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }
  .soon {
    font-size: var(--step--1);
  }
  .also {
    width: 100%;
    margin-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .also a {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    background: var(--backdrop);
  }
  .thumb picture {
    width: 80%;
    height: 88%;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .also-text {
    display: grid;
    gap: 0.2rem;
  }
  .also-name {
    font-family: var(--serif);
    font-size: var(--step-1);
  }
  .also .arrow {
    transition: transform 0.3s var(--ease);
  }
  .also a:hover .arrow {
    transform: translateX(4px);
    color: var(--cherry);
  }

  .pillars-head {
    row-gap: 0;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .pillars-head .kicker {
    grid-column: 1 / -1;
  }
  .pillars-head h2 {
    grid-column: 1 / span 8;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }
  .cols li:nth-child(2) {
    margin-top: clamp(0rem, 5vw, 5rem);
  }
  .pmeta {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
    max-width: 24rem;
  }
  .pn {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--cherry);
    letter-spacing: 0;
  }
  .more {
    margin-top: 3rem;
  }

  .story-media {
    position: relative;
    min-height: min(88vh, 820px);
    color: var(--paper);
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }
  .story-media > :global(.photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .story-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(12 18 11 / 0.72) 0%, rgb(12 18 11 / 0.15) 60%);
  }
  .story-head {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: 6rem clamp(3rem, 2rem + 3vw, 5rem);
  }
  .story-head .kicker {
    margin-bottom: 0;
  }
  .story-head .kicker .num {
    color: var(--rust-light);
  }
  .story-head h2 {
    max-width: 14ch;
  }
  .story-head p {
    max-width: 36rem;
    color: rgb(245 244 239 / 0.88);
  }

  .wholesale .grid-12 {
    align-items: center;
    row-gap: 3rem;
  }
  .ws-text {
    grid-column: 1 / span 6;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .ws-text .kicker {
    margin-bottom: 0;
  }
  .ws-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .ws-photos {
    grid-column: 8 / span 5;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: end;
  }
  .ws-photos :global(.ws-a) {
    margin-bottom: 3rem;
  }

  @media (max-width: 900px) {
    .feature-media,
    .feature-text,
    .intro-statement,
    .intro-aside,
    .pillars-head h2,
    .ws-text,
    .ws-photos {
      grid-column: 1 / -1;
    }
    .feature-media {
      max-width: 560px;
    }
    .cols {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .cols li:nth-child(2) {
      margin-top: 0;
    }
    .cols li {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: 1.25rem;
      align-items: end;
    }
    .pmeta {
      margin-top: 0;
    }
  }
  @media (max-width: 600px) {
    .cols li {
      grid-template-columns: 1fr;
    }
    .cols li :global(.frame) {
      aspect-ratio: 4 / 3 !important;
    }
  }
</style>
