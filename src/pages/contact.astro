---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../config/site';
---

<Base title="Contact" description="Get in touch with Woodfox Coffee in Houston, Texas. Call 713-742-2709 or email us about coffee, orders, wholesale or events.">
  <section class="contact">
    <div class="wrap grid-12">
      <div class="side">
        <p class="label muted">Contact</p>
        <h1 class="h1 title">Say <em>hello.</em></h1>
        <p class="body-lg">
          Call, email or use the form. Every message is read by a person, usually the same one roasting the coffee.
        </p>

        <div class="channels">
          <div class="channel">
            <h2 class="label">General inquiries</h2>
            <p class="muted">Questions, ideas, events, or just to say hi.</p>
            <a class="ch-link" href={site.emailHref}>{site.email}</a>
          </div>
          <div class="channel">
            <h2 class="label">Orders, shipping &amp; wholesale</h2>
            <p class="muted">Wholesale, orders and anything to do with shipping.</p>
            <a class="ch-link" href={site.ordersHref}>{site.ordersEmail}</a>
          </div>
          <div class="channel">
            <h2 class="label">Phone</h2>
            <a class="ch-link" href={site.phoneHref}>{site.phone}</a>
          </div>
        </div>

        <dl class="details">
          <div>
            <dt class="label muted">Company</dt>
            <dd>{site.legalName}</dd>
          </div>
          <div>
            <dt class="label muted">Location</dt>
            <dd>{site.location}</dd>
          </div>
          {site.social.length > 0 && (
            <div>
              <dt class="label muted">Follow</dt>
              <dd>{site.social.map((s, i) => <>{i > 0 && ' · '}<a href={s.href} rel="noopener">{s.label}</a></>)}</dd>
            </div>
          )}
        </dl>
      </div>

      <div class="form-col">
        <InquiryForm variant="contact" />
      </div>
    </div>
  </section>
</Base>

<script>
  // Allow links like /contact/?topic=collaboration to preselect a topic.
  const topic = new URLSearchParams(location.search).get('topic');
  if (topic) {
    const radio = document.querySelector<HTMLInputElement>(`input[name="topic"][value="${CSS.escape(topic)}"]`);
    if (radio) radio.checked = true;
  }
</script>

<style>
  .contact {
    padding-block: clamp(3.5rem, 2rem + 6vw, 8rem) var(--section);
  }
  .grid-12 {
    row-gap: 3.5rem;
    align-items: start;
  }
  .side {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.75rem;
  }
  .title {
    font-size: var(--step-5);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .title em {
    color: var(--cherry);
  }
  .channels {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .channel {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .channel h2 {
    color: var(--cherry);
  }
  .channel p {
    font-size: 0.9375rem;
  }
  .ch-link {
    font-family: var(--serif);
    font-size: var(--step-1);
    text-decoration: none;
    justify-self: start;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
  }
  .ch-link:hover {
    color: var(--cherry);
  }
  .details {
    border-top: 1px solid var(--line);
  }
  .details div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .details dt {
    padding-top: 0.2rem;
  }
  .details a {
    overflow-wrap: anywhere;
  }
  .form-col {
    grid-column: 7 / span 6;
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    background: var(--paper-light);
    border: 1px solid var(--line);
  }
  @media (max-width: 900px) {
    .side,
    .form-col {
      grid-column: 1 / -1;
    }
  }
</style>
