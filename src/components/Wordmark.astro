---
/** Text wordmark carried over from the current Woodfox site. Replace with an SVG logo when one exists. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>
  <span class="wm-main">Woodfox</span>
  <span class="wm-sub">Coffee</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .wm-main {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variation-settings: 'opsz' 48;
  }
  .wm-sub {
    margin-top: 0.3rem;
    font-family: var(--serif);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    padding-left: 0.38em;
  }
</style>
