---
import Wordmark from './Wordmark.astro';
import { site, nav, legal } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer surface-coffee on-dark">
  <div class="wrap">
    <div class="top">
      <p class="statement">
        Crafted with <em>Intention.</em>
      </p>
      <a href="/coffee/" class="link">Explore our coffee <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <hr class="rule" />

    <div class="cols">
      <div class="about">
        <a href="/" class="brand" aria-label="Woodfox Coffee, home"><Wordmark /></a>
        <p class="muted">
          {site.legalName} is a Houston-based specialty coffee roaster focused on thoughtful sourcing and precision,
          micro-batch roasting.
        </p>
      </div>

      <nav class="col" aria-label="Footer">
        <p class="label muted">Explore</p>
        <ul role="list">
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="col contact">
        <p class="label muted">Contact</p>
        <dl>
          <div>
            <dt>Phone</dt>
            <dd><a href={site.phoneHref}>{site.phone}</a></dd>
          </div>
          <div>
            <dt>General inquiries</dt>
            <dd><a href={site.emailHref}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Orders, shipping &amp; wholesale</dt>
            <dd><a href={site.ordersHref}>{site.ordersEmail}</a></dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{site.location}</dd>
          </div>
        </dl>
        {site.social.length > 0 && (
          <ul role="list" class="social">
            {site.social.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}
          </ul>
        )}
      </div>

      <nav class="col" aria-label="Policies">
        <p class="label muted">Policies</p>
        <ul role="list">
          {legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="bottom muted">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p>Houston, Texas</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #22301f;
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) 2rem;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .statement {
    font-family: var(--serif);
    font-size: var(--step-4);
    font-weight: 360;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .statement em {
    color: var(--rust-light);
  }
  .cols {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1.5fr 1.1fr;
    gap: 2.5rem;
    padding-block: 3rem;
  }
  .about {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    max-width: 22rem;
    font-size: 0.9375rem;
  }
  .brand {
    text-decoration: none;
    justify-self: start;
  }
  .brand :global(.wordmark) {
    align-items: flex-start;
  }
  .col ul {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }
  .contact dl {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }
  .contact dt {
    font-size: 0.75rem;
    color: rgb(245 244 239 / 0.6);
    margin-bottom: 0.1rem;
  }
  .contact dd {
    font-size: 0.9375rem;
  }
  .col a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.35s var(--ease);
    overflow-wrap: break-word;
  }
  .col a:hover {
    background-size: 100% 1px;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
    font-size: var(--step--1);
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 420px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
