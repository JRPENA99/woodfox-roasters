---
import ProductImage from './ProductImage.astro';
import { commerce } from '../config/site';
import { money, fromPrice, statusLabel, type Product } from '../data/products';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}
const { product: p, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const price = fromPrice(p);
const placeholder = p.status === 'placeholder';
const origin = [p.region, p.origin].filter(Boolean).join(', ') || (placeholder ? 'Packaging concept' : 'Origin to be announced');
---

<article class:list={['product', { 'is-placeholder': placeholder }]}>
  <a href={`/coffee/${p.id}/`} class="link-wrap">
    <div class="media">
      <ProductImage product={p} />
    </div>
    <div class="meta">
      <p class="label kicker-line"><span class="status" data-status={p.status}>{statusLabel[p.status]}</span><span class="sep" aria-hidden="true">·</span><span class="muted">{origin}</span></p>
      <div class="row">
        <H class="name">{p.name}</H>
        {commerce.enabled && price != null && <p class="price">{money(price, commerce.currency)}</p>}
      </div>
      <p class="facts muted">
        {placeholder ? 'Details to be announced' : <>{p.roast} roast{p.notes.length > 0 && <> · {p.notes.join(', ')}</>}</>}
      </p>
    </div>
  </a>
</article>

<style>
  .link-wrap {
    display: grid;
    gap: 1rem;
    text-decoration: none;
  }
  .media {
    position: relative;
    overflow: hidden;
  }
  .link-wrap:hover :global(img) {
    transform: translateY(-6px);
  }
  .kicker-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .status {
    color: var(--moss);
  }
  .status[data-status='placeholder'] {
    color: var(--cherry);
  }
  .sep {
    color: var(--muted);
  }
  .meta {
    display: grid;
    gap: 0.35rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }
  .name {
    font-family: var(--serif);
    font-weight: 420;
    font-size: var(--step-2);
    line-height: 1.15;
    transition: color 0.2s;
  }
  .link-wrap:hover .name {
    color: var(--cherry);
  }
  .facts {
    font-size: 0.9375rem;
  }
</style>
