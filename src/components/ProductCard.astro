---
import BagArt from './BagArt.astro';
import Photo from './Photo.astro';
import { commerce } from '../config/site';
import { money, fromPrice, statusLabel, type Product } from '../data/products';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}
const { product: p, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const price = fromPrice(p);
const placeholder = p.status === 'placeholder';
const origin = [p.region, p.origin].filter(Boolean).join(', ') || 'Origin to be announced';
---

<article class:list={['product', { 'is-placeholder': placeholder }]}>
  <a href={`/coffee/${p.id}/`} class="link-wrap">
    <div class="media">
      {p.image ? (
        <Photo image={{ src: p.image, alt: p.imageAlt ?? `${p.name} coffee bag` }} ratio="4 / 5" sizes="(min-width: 900px) 33vw, 100vw" />
      ) : (
        <BagArt name={p.name} colors={p.colors} label={placeholder ? 'Placeholder' : p.roast} />
      )}
      <span class="badge label" data-status={p.status}>{statusLabel[p.status]}</span>
    </div>
    <div class="meta">
      <p class="label muted">{origin}</p>
      <div class="row">
        <H class="name">{p.name}</H>
        {commerce.enabled && price != null && <p class="price">{money(price, commerce.currency)}</p>}
      </div>
      <p class="facts muted">
        {p.roast} roast{p.notes.length > 0 && <> · {p.notes.join(', ')}</>}
      </p>
    </div>
  </a>
</article>

<style>
  .link-wrap {
    display: grid;
    gap: 1rem;
    text-decoration: none;
  }
  .media {
    position: relative;
    overflow: hidden;
  }
  .media :global(.bag-art),
  .media :global(img) {
    transition: transform 0.8s var(--ease);
  }
  .link-wrap:hover :global(.bag-art),
  .link-wrap:hover :global(img) {
    transform: scale(1.025);
  }
  .badge {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.35rem 0.6rem;
    background: var(--paper-light);
    font-size: 0.625rem;
    color: var(--moss);
  }
  .badge[data-status='placeholder'] {
    color: var(--cherry);
    border: 1px dashed currentColor;
  }
  .meta {
    display: grid;
    gap: 0.35rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }
  .name {
    font-family: var(--serif);
    font-weight: 420;
    font-size: var(--step-2);
    line-height: 1.15;
    transition: color 0.2s;
  }
  .link-wrap:hover .name {
    color: var(--cherry);
  }
  .facts {
    font-size: 0.9375rem;
  }
</style>
