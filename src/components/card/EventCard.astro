---
/**
 * Woodfox Coffee event card. Same structure as Tony's card: name and role,
 * Save Contact, action grid, details list, QR with share, footer.
 */
import SilkBackground from './SilkBackground.astro';
import ContactActions from './ContactActions.astro';
import CardQR from './CardQR.astro';
import { site } from '../../config/site';
import { resolveProfile, eventCardPath, eventVcfPath, type EventCard } from '../../data/eventCards';

interface Props {
  card: EventCard;
}
const { card } = Astro.props;
const p = resolveProfile(card);
const url = new URL(eventCardPath(card), site.url).href;
const websiteLabel = p.website.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<div class="event-card">
  <SilkBackground id={`ev${card.id}`} />

  <main class="wrap" id="main">
    <h1 class="name enter" style="--d:0">{p.name}</h1>
    <p class="subtitle enter" style="--d:1">{p.subtitle}</p>

    <a class="save enter" style="--d:2" href={eventVcfPath(card)} download={p.vcfName} type="text/vcard">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"></path><path d="M19 3v6M16 6h6"></path></svg>
      <span>Save Contact</span>
    </a>

    <div class="block enter" style="--d:3">
      <ContactActions name={p.name} phone={p.phone} email={p.email} website={p.website} />
    </div>

    <dl class="details enter" style="--d:4">
      {p.phone && p.phoneDisplay && (
        <div><dt>Phone</dt><dd><a href={`tel:${p.phone}`}>{p.phoneDisplay}</a></dd></div>
      )}
      <div><dt>Email</dt><dd><a href={`mailto:${p.email}`}>{p.email}</a></dd></div>
      <div><dt>Location</dt><dd><span>{p.city}, {p.region}</span></dd></div>
    </dl>

    <section class="qr-row enter" style="--d:5" aria-labelledby="qr-label">
      <CardQR url={url} label={`QR code linking to the ${p.name} event card`} size={124} />
      <div class="qr-side">
        <p id="qr-label" class="qr-label">Scan or tap to connect.</p>
        <button type="button" class="share" data-share data-url={url} data-title={`${p.name} | ${p.subtitle}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 15V3M7 8l5-5 5 5"></path><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path></svg>
          <span data-share-label>Share link</span>
        </button>
        <p class="share-status" role="status" aria-live="polite" data-share-status></p>
      </div>
    </section>

    <footer class="foot enter" style="--d:6">
      <a href={p.website}>{websiteLabel}</a>
      <span aria-hidden="true">·</span>
      <span>{p.city}, {p.region}</span>
    </footer>
  </main>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-share]');
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  const label = document.querySelector<HTMLElement>('[data-share-label]');
  if (btn) {
    const url = btn.dataset.url!;
    const canShare = typeof navigator.share === 'function';
    if (!canShare && label) label.textContent = 'Copy link';
    btn.addEventListener('click', async () => {
      if (canShare) {
        try {
          await navigator.share({ title: btn.dataset.title, url });
          return;
        } catch (err) {
          if ((err as DOMException).name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = 'Link copied';
      } catch {
        if (status) status.textContent = url;
      }
      setTimeout(() => status && (status.textContent = ''), 3000);
    });
  }
</script>

<style>
  .event-card {
    --white: #f3f2ef;
    --white-dim: #c9c7c3;
    --steel: #8f8d8a;
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    background: #080706;
    color: var(--white);
    isolation: isolate;
  }
  .wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    padding: max(64px, calc(env(safe-area-inset-top) + 44px)) 22px max(24px, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .name {
    font-family: var(--serif);
    font-weight: 380;
    font-size: clamp(2.3rem, 10vw, 2.85rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .subtitle {
    margin-top: 12px;
    font-size: 0.78rem;
    font-weight: 560;
    letter-spacing: 0.24em;
    padding-left: 0.24em;
    text-transform: uppercase;
    color: var(--white);
  }

  /* Save Contact */
  .save {
    position: relative;
    overflow: hidden;
    margin-top: 30px;
    width: 100%;
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #ffffff 0%, #dcdbd8 45%, #a9a7a3 100%);
    color: #121212;
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow:
      0 10px 28px rgb(0 0 0 / 0.45),
      inset 0 1px 0 rgb(255 255 255 / 0.35);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      filter 0.25s ease;
  }
  .save > * {
    position: relative;
    z-index: 1;
  }
  .save::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 36%;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.7), transparent);
    transform: translateX(-130%) skewX(-18deg);
    animation: sheen 6.5s ease-in-out infinite 2.4s;
  }
  .save:hover {
    filter: brightness(1.04);
    box-shadow:
      0 14px 34px rgb(255 255 255 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.35);
  }
  .save:active {
    transform: scale(0.985);
  }
  .save:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 3px;
  }

  .block {
    width: 100%;
    margin-top: 14px;
  }

  /* Details */
  .details {
    margin-top: 22px;
    width: 100%;
    border-top: 1px solid rgb(236 235 232 / 0.18);
  }
  .details div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 48px;
    border-bottom: 1px solid rgb(236 235 232 / 0.12);
  }
  .details dt {
    font-size: 0.68rem;
    font-weight: 560;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--white-dim);
  }
  .details dd {
    min-width: 0;
  }
  .details a,
  .details span {
    display: inline-block;
    padding-block: 12px;
    color: var(--white);
    text-decoration: none;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }
  .details a:hover {
    color: #fff;
  }

  /* QR */
  .qr-row {
    margin-top: 24px;
    width: 100%;
    display: grid;
    grid-template-columns: 124px 1fr;
    gap: 18px;
    align-items: center;
    text-align: left;
  }
  .qr-side {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .qr-label {
    font-size: 0.85rem;
    color: var(--white-dim);
  }
  .share {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgb(236 235 232 / 0.4);
    background: transparent;
    color: var(--white);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.25s ease;
  }
  .share:hover {
    background: rgb(255 255 255 / 0.08);
  }
  .share:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 3px;
  }
  .share-status {
    min-height: 1.2em;
    font-size: 0.8rem;
    color: var(--white);
    overflow-wrap: anywhere;
  }

  /* Footer */
  .foot {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--white);
  }
  .foot a:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 3px;
  }

  /* Motion */
  .enter {
    animation: enter 0.9s cubic-bezier(0.22, 0.8, 0.24, 1) both;
    animation-delay: calc(var(--d, 0) * 80ms + 100ms);
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes sheen {
    0% {
      transform: translateX(-130%) skewX(-18deg);
    }
    35%,
    100% {
      transform: translateX(300%) skewX(-18deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enter,
    .save::after {
      animation: none;
    }
    .save::after {
      display: none;
    }
  }
  @media (max-width: 350px) {
    .qr-row {
      grid-template-columns: 104px 1fr;
      gap: 14px;
    }
  }
</style>
