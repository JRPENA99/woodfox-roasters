---
/**
 * Call / Email / Website buttons in a three-column grid.
 * Phone actions render disabled (no link) until a phone number is configured.
 */
interface Props {
  name: string;
  phone: string | null;
  email: string;
  website: string;
}
const { name, phone, email, website } = Astro.props;
const site = website.replace(/^https?:\/\//, '').replace(/\/$/, '');

const icons = {
  call: '<path d="M6.6 3.5h2.6l1.4 4.1-2 1.3a12 12 0 0 0 6.5 6.5l1.3-2 4.1 1.4v2.6a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m4 7 8 6 8-6"/>',
  web: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/>',
};

const actions = [
  { key: 'call', label: 'Call', href: phone ? `tel:${phone}` : null, aria: `Call ${name}` },
  { key: 'email', label: 'Email', href: `mailto:${email}`, aria: `Email ${name} at ${email}` },
  { key: 'web', label: 'Website', href: website, aria: `Visit ${site}` },
] as const;
---

<nav class="actions" aria-label={`Contact ${name}`}>
  {actions.map((a) =>
    a.href ? (
      <a class="action" href={a.href} aria-label={a.aria}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[a.key]} />
        <span>{a.label}</span>
      </a>
    ) : (
      <span class="action is-off" aria-disabled="true" title="Number coming soon">
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[a.key]} />
        <span>{a.label}</span>
        <span class="sr-only">(not available yet)</span>
      </span>
    ),
  )}
</nav>

<style>
  .actions {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .action {
    min-height: 72px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 6px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(236 235 232 / 0.24);
    color: #f3f2ef;
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 560;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.2s ease;
  }
  .action svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: #f3f2ef;
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  a.action:hover {
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(236 235 232 / 0.5);
  }
  a.action:active {
    transform: scale(0.97);
  }
  a.action:focus-visible {
    outline: 2px solid #f3f2ef;
    outline-offset: 3px;
  }
  .is-off {
    opacity: 0.35;
    cursor: default;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 350px) {
    .actions {
      gap: 6px;
    }
    .action {
      min-height: 64px;
      font-size: 0.65rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .action {
      transition: none;
    }
  }
</style>
