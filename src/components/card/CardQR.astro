---
/** QR code generated at build time as inline SVG (no external service, no client JS). */
import QRCode from 'qrcode';

interface Props {
  url: string;
  label: string;
  size?: number;
}
const { url, label, size = 132 } = Astro.props;
const svg = await QRCode.toString(url, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 4,
  color: { dark: '#111111ff', light: '#f2f1eeff' },
});
---

<div class="qr" role="img" aria-label={label} style={`--qr-size:${size}px`} set:html={svg} />

<style>
  .qr {
    width: var(--qr-size);
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    background: #f2f1ee;
    box-shadow:
      0 0 0 1px rgb(236 235 232 / 0.35),
      0 12px 30px rgb(0 0 0 / 0.45);
  }
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
